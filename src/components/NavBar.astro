---
import { Image } from 'astro:assets';
import { SITE_DESCRIPTION } from '../consts';
import iconHome from '../assets/icons/icon-home.png';
import iconBlog from '../assets/icons/icon-blog.png';
import iconPics from '../assets/icons/icon-pics.png';
import iconAbout from '../assets/icons/icon-about.png';
import iconGuestbook from '../assets/icons/icon-guestbook.png';
---

<nav class="navbar">

  <div class="navbar-links">
    <ul>
      <li><a href="/">
        <Image src={iconHome} alt="" />
        Home
      </a></li>
      <li><a href="/blog">
        <Image src={iconBlog} alt="" />
        Blog
      </a></li>
      <li><a href="/pics">
        <Image src={iconPics} alt="" />
        Pics
      </a></li>
      <li><a href="/about">
        <Image src={iconAbout} alt="" />
        About
      </a></li>
      <li><a href="/guestbook">
        <Image src={iconGuestbook} alt="" />
        Guestbook
      </a></li>
    </ul>
  </div>

  <div class="navbar-search">
     <form>
        <input type="text" placeholder="Search..." />
        <button type="submit">GO!</button>
     </form>
  </div>
</nav>

<div class="statusbar">
  <span>{SITE_DESCRIPTION}</span>
  <span>15/08/2026</span>
</div>