---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allPics = await getCollection('pics');
// Tomar las 3 fotos más recientes
const latestPics = allPics
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

function formatDate(date: Date) {
  const day = String(date.getDate()).padStart(2, '0');
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const year = date.getFullYear();
  return `${day}/${month}/${year}`;
}
---

<div class="latest-pics-container">
  <div class="latest-pics-grid">
    {latestPics.map((pic) => (
      <a href="/pics" class="latest-pic-card">
        <div class="latest-pic-window">
          <div class="latest-pic-titlebar">
            <span>{pic.id}.jpg</span>
            <span>✕</span>
          </div>
          <div class="latest-pic-frame">
            <Image src={pic.data.image} alt={pic.data.title} class="latest-pic-img" />
          </div>
        </div>
        <div class="latest-pic-meta">
          <span class="latest-pic-title">{pic.data.title}</span>
          <span class="latest-pic-date">{formatDate(pic.data.pubDate)}</span>
        </div>
      </a>
    ))}

    {latestPics.length === 0 && (
      <p style="opacity: 0.6; font-size: 0.85rem;">No pics uploaded yet.</p>
    )}
  </div>
  <a href="/pics" class="latest-pics-link">&gt; view all pics_</a>
</div>

<style>
  .latest-pics-container {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 6px;
    font-family: var(--font-mono, monospace);
  }

  .latest-pics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .latest-pic-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s;
  }

  .latest-pic-card:hover {
    transform: translateY(-2px);
  }

  .latest-pic-window {
    border: 2px solid var(--color-accent, #23195b);
    background: #ffffff;
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.15);
    overflow: hidden;
  }

  .latest-pic-titlebar {
    background: #7b74b6;
    color: #ffffff;
    padding: 2px 4px;
    font-size: 0.7rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .latest-pic-frame {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #000;
  }

  .latest-pic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .latest-pic-meta {
    padding-top: 4px;
    display: flex;
    flex-direction: column;
  }

  .latest-pic-title {
    font-size: 0.8rem;
    font-weight: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .latest-pic-date {
    font-size: 0.7rem;
    color: #666;
  }

  .latest-pics-link {
    align-self: flex-start;
    color: var(--color-accent-hover, #8f1c6c);
    text-decoration: none;
    font-size: 0.85rem;
    margin-top: 4px;
  }

  .latest-pics-link:hover {
    text-decoration: underline;
  }
</style>
