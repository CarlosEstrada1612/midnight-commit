---
interface Props {
    title: string;
    isStatic?: boolean;
    id?: string;
}

const { title, isStatic = false, id } = Astro.props;
---

<div class:list={['window', { 'window--static': isStatic }]} id={id}>
  <div class="window-titlebar">
    <span class="window-title">{title}</span>
    <div class="window-buttons">
      <button class="btn-minimize">_</button>
      <button class="btn-maximize">□</button>
      <button class="btn-close">✕</button>
    </div>
  </div>

  <div class="window-content">
    <slot />
  </div>
</div>

<script>
    const ventanas = document.querySelectorAll('.window');
    ventanas.forEach((ventana) => {
        const minimizeButton = ventana.querySelector('.btn-minimize');
        if (minimizeButton) {
            minimizeButton.addEventListener('click', () => {
                ventana.classList.toggle('minimized');
            });
        }
        const maximizeButton = ventana.querySelector('.btn-maximize');
        if (maximizeButton) {
            maximizeButton.addEventListener('click', () => {
                if(ventana.classList.contains('maximized')) {
                    (ventana as HTMLElement).style.left = (ventana as HTMLElement).dataset.prevLeft || '';
                    (ventana as HTMLElement).style.top = (ventana as HTMLElement).dataset.prevTop || '';
                } else {
                    (ventana as HTMLElement).dataset.prevLeft = (ventana as HTMLElement).style.left;
                    (ventana as HTMLElement).dataset.prevTop  = (ventana as HTMLElement).style.top;
                    (ventana as HTMLElement).style.left = '';
                    (ventana as HTMLElement).style.top  = '';
                }
                ventana.classList.toggle('maximized');
            });
        }
        const closeButton = ventana.querySelector('.btn-close');
        if (closeButton) {
            closeButton.addEventListener('click', () => {
                ventana.classList.add('hidden');
            });
        }
        const titleBar = ventana.querySelector('.window-titlebar');
        if(titleBar) {
            titleBar.addEventListener('mousedown', (e) => {
                if(ventana.classList.contains('maximized')) return;

                const offsetX = (e as MouseEvent).clientX - (ventana as HTMLElement).offsetLeft;
                const offsetY = (e as MouseEvent).clientY - (ventana as HTMLElement).offsetTop;

                const HandleMouseMove = (e: MouseEvent) => {
                    (ventana as HTMLElement).style.left = e.clientX - offsetX + 'px';
                    (ventana as HTMLElement).style.top  = e.clientY - offsetY + 'px';
                };

                document.addEventListener('mousemove', HandleMouseMove);

                const HandleMouseUp = () => {
                    document.removeEventListener('mousemove', HandleMouseMove);
                    document.removeEventListener('mouseup', HandleMouseUp);
                };

                document.addEventListener('mouseup', HandleMouseUp);
            });
        }
    });

</script>