---
import '../styles/windows.css';

interface Props {
    title: string;
    isStatic?: boolean;
    id?: string;
}

const { title, isStatic = false, id } = Astro.props;
---

<div class:list={['window', { 'window--static': isStatic }]} id={id}>
  <div class="window-titlebar">
    <span class="window-title">{title}</span>
    <div class="window-buttons">
      <button class="btn-minimize">_</button>
      <button class="btn-maximize">□</button>
      <button class="btn-close">✕</button>
    </div>
  </div>

  <div class="window-content">
    <slot />
  </div>
</div>

<script>
  function initWindows() {
    const ventanas = document.querySelectorAll<HTMLElement>('.window');
    ventanas.forEach((ventana) => {
        if (ventana.dataset.initialized) return;
        ventana.dataset.initialized = 'true';
        // Minimizar: mostrar u ocultar el contenido.
        const minimizeButton = ventana.querySelector('.btn-minimize');
        if (minimizeButton) {
            minimizeButton.addEventListener('click', () => {
                ventana.classList.toggle('minimized');
            });
        }

        // Maximizar: guardar la posición para poder restaurarla.
        const maximizeButton = ventana.querySelector('.btn-maximize');
        if (maximizeButton) {
            maximizeButton.addEventListener('click', () => {
                if (ventana.classList.contains('maximized')) {
                    ventana.style.left = ventana.dataset.prevLeft || '';
                    ventana.style.top = ventana.dataset.prevTop || '';
                } else {
                    ventana.dataset.prevLeft = ventana.style.left;
                    ventana.dataset.prevTop  = ventana.style.top;
                    ventana.style.left = '';
                    ventana.style.top  = '';
                }
                ventana.classList.toggle('maximized');
            });
        }

        // Cerrar: ocultar la ventana.
        const closeButton = ventana.querySelector('.btn-close');
        if (closeButton) {
            closeButton.addEventListener('click', () => {
                ventana.classList.add('hidden');
            });
        }

        // Arrastrar desde la barra de título, solo en escritorio.
        const titleBar = ventana.querySelector<HTMLElement>('.window-titlebar');
        if (titleBar) {
            titleBar.addEventListener('mousedown', (e) => {
                if (e.button !== 0 || !window.matchMedia('(min-width: 1201px)').matches) return;
                if (ventana.classList.contains('maximized') || ventana.classList.contains('window--static')) return;
                if ((e.target as Element).closest('button')) return;

                e.preventDefault();
                const offsetX = e.clientX - (parseFloat(ventana.style.left) || 0);
                const offsetY = e.clientY - (parseFloat(ventana.style.top) || 0);

                const handleMouseMove = (e: MouseEvent) => {
                    ventana.style.left = e.clientX - offsetX + 'px';
                    ventana.style.top  = e.clientY - offsetY + 'px';
                };

                document.addEventListener('mousemove', handleMouseMove);

                const handleMouseUp = () => {
                    document.removeEventListener('mousemove', handleMouseMove);
                    document.removeEventListener('mouseup', handleMouseUp);
                };

                document.addEventListener('mouseup', handleMouseUp);
            });
        }
    });
  }
  initWindows();
  document.addEventListener('astro:page-load', initWindows);

</script>
