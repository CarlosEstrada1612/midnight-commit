---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latest = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)[0];

const date = latest.data.pubDate.toLocaleDateString('es-PE', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
});
---

<div class="latest-commit">
  {latest.data.heroImage && (
    <div class="latest-image">
      <Image src={latest.data.heroImage} alt={latest.data.title} />
    </div>
  )}

  <div class="latest-body">
    {latest.data.category && (
      <span class="latest-category">{latest.data.category.toUpperCase()}</span>
    )}
    <h2 class="latest-title">
      <a href={`/blog/${latest.id}/`}>{latest.data.title}</a>
    </h2>
    <p class="latest-meta">
      {date}
      {latest.data.minRead && <span> // {latest.data.minRead} min read</span>}
    </p>
    <p class="latest-desc">{latest.data.description}</p>
    <a href={`/blog/${latest.id}/`} class="latest-readmore">&gt; read more_</a>
  </div>
</div>