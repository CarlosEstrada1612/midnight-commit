---
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
  <div class="header-logo">
    <a href="/">
      <img src="/images/site/logo.png" alt={SITE_TITLE} />
    </a>
  </div>

  <div class="header-meta">
    <p>personal<br />weblog<br />since 2026</p>
    <div class="version-badge">ver. 0.1</div>
  </div>

  <div class="header-image">
    <img src="/images/site/header-img.png" alt="City Pop" />
  </div>
</header>