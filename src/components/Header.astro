---
import { Image } from 'astro:assets';
import { SITE_TITLE } from '../consts';
import logoImg from '../assets/site/logo.png';
import headerImg from '../assets/site/header-img.jpg';
---

<header class="site-header">
  <div class="header-logo">
    <a href="/">
      <Image src={logoImg} alt={SITE_TITLE} />
    </a>
  </div>

  <div class="header-meta">
    <p>personal<br />weblog<br />since 2026</p>
    <div class="version-badge">ver. 0.1</div>
  </div>

  <div class="header-image">
    <Image src={headerImg} alt="City Pop" />
  </div>
</header>