---
import '../styles/home.css';
import Layout from '../layouts/layout.astro';
import Window from '../components/Window.astro';
import { Image } from 'astro:assets';
import avatarImg from '../assets/gifs/SH43HVSNNR5LCLWDEF6OICFL57AKIQMN.gif';
import computerImg from '../assets/gifs/4TVNIZNSYD44M7OOOJ7DPQDA5K2TB46S.gif';
import LatestCommit from '../components/LatestCommit.astro';
import Calendar from '../components/Calendar.astro';
import Gameboy from '../assets/site/s-l1200.png';
import marioWalk from '../assets/gifs/DKOVUOTX5YK675CEULVSMQA45GHR6XEI.gif';
import LatestPics from '../components/LatestPics.astro';
import luigiGif from '../assets/gifs/ddxwwyt-dee720b1-5aec-4a0a-b118-6799073003a8.gif';
import linkGif from '../assets/gifs/2SWAKUHBYODDQRSXEICIFTKQ3SDSATTX.gif';
---

<Layout title="Midnight Commit">
  <div class="windows-container">

    <div class="home-windows">
      <Window title="about me" id="win-about">
        <div class="about-window">
          <div class="about-top">
            <Image src={avatarImg} alt="avatar" />
            <div class="about-intro">
              <p>Hey! I'm <span class="about-name">Carlos</span>.</p>
              <p>Computer Science enthusiast who loves retro games, old websites & city pop.</p>
            </div>
          </div>
          <p>PUCP Student, Linux user, vintage web developer, peru es clave</p>
          <a class="about-link" href="/about"> &gt; more about me_</a>
        </div>
      </Window>

      <Window title="latest commit" id="win-latest">
        <LatestCommit />
      </Window>

      <Window title="my system" id="win-system">
        <div class="system-window">
          <div class="system-top">
            <Image src={computerImg} alt="computer"/>
            <div class="system-parts">
              <p>OS0: Windows 10</p>
              <p>OS1: Linux Mint</p>
              <p>CPU: Intel i7 4th</p>
              <p>RAM: 12GB DDR3</p>
              <p>GPU: RX 590 GME</p>
            </div>
          </div>
        </div>
        <img src="src/assets/gifs/win98_891.gif"/>
        <img src="src/assets/gifs/n64_com_now.gif"/>
        <img src="src/assets/gifs/thedigitalme.gif"/>
        <img src="src/assets/gifs/wii_button.gif"/>
      </Window>

    </div>

    <section class="gameboy-corner" aria-label="Mi rincón retro">
      <div class="retro-panel">
        <p class="retro-panel-label">BANK 01 · DAILY SAVE</p>
        <Window title="calendar" id="win-calendar" isStatic>
          <Calendar />
        </Window>
        <img src={luigiGif.src} width={luigiGif.width} height={luigiGif.height} alt="Luigi" class="memory-character memory-character--luigi" />
        <p class="retro-panel-note">0x0001 · one day, one little memory.</p>
      </div>

      <div class="gameboy">
        <Image src={Gameboy} alt="Nintendo Game Boy" class="gameboy-shell" />
        <div class="gameboy-screen">
          <img src={marioWalk.src} alt="Mario caminando en la pantalla" class="gameboy-mario" />
        </div>
      </div>

      <div class="retro-panel">
        <p class="retro-panel-label">BANK 02 · MEMORY CARD</p>
        <Window title="latest pics" id="win-pics" isStatic>
          <LatestPics />
        </Window>
        <img src={linkGif.src} width={linkGif.width} height={linkGif.height} alt="Link" class="memory-character memory-character--link" />
        <p class="retro-panel-note">0x0002 · a few pixels worth keeping.</p>
      </div>
    </section>

  </div>
</Layout>
