---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/layout.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog — Midnight Commit">
  <div class="blog-layout">

    <!-- SIDEBAR IZQUIERDO -->
    <aside class="blog-sidebar-left">
      <div class="panel"> Avatar y Bio </div>
      <div class="panel"> Folders (Categorías) </div>
      <div class="panel"> Calendario </div>
      <div class="panel"> Contador de visitas </div>
    </aside>

    <!-- CONTENIDO CENTRAL -->
    <main class="blog-main">
      <div class="blog-header">
        <img src="/src/assets/gifs/5CP7LF6CKD7WQH7ABZKHZJPAY72FJHLF.gif" alt="Blog Header" class="blog-header-image" />
      </div>

      {posts.map((post) => (
        <article class="post-entry">
          <div class="post-date">
            <span class="post-month">
              {post.data.pubDate.toLocaleDateString('en-US', { month: 'short' }).toUpperCase()}
            </span>
            <span class="post-day">{post.data.pubDate.getDate()}</span>
            <span class="post-year">{post.data.pubDate.getFullYear()}</span>
          </div>

          <div class="post-body">
            {post.data.category && <span class="post-category">{post.data.category.toUpperCase()}</span>}
            {post.data.minRead && <span class="post-readtime"> • {post.data.minRead} min read</span>}
            <h2 class="post-title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="post-description">{post.data.description}</p>
            <a href={`/blog/${post.id}/`} class="post-readmore">&gt; read entry_</a>
          </div>
        </article>
      ))}

    </main>

    <!-- SIDEBAR DERECHO -->
    <aside class="blog-sidebar-right">
      <div class="panel"> Chat Room </div>
      <div class="panel"> Recent Posts </div>
      <div class="panel"> Mapa / Clima de Lima </div>
    </aside>

  </div>
</Layout>
<script>

  const today=new Date();
  const currentYear = today.getFullYear();
  const currentMonth = today.getMonth();
  const currentDay = today.getDate();

  let month = new Date().getMonth();
  let year = new Date().getFullYear();

  function generateCalendar(month: number, year: number) {
    const firstDay = new Date(year, month, 1).getDay();
    const lastDate = new Date(year, month + 1, 0).getDate();
    const calendarDays = [];

    for (let i = 0; i < firstDay; i++) {
      calendarDays.push('');
    }

    for (let day = 1; day <= lastDate; day++) {
      calendarDays.push(day);
    }

    const grid = document.getElementById('calendar-grid');
    if (!grid) {
      return calendarDays;
    }

    grid.innerHTML = '';  // limpia el grid antes de dibujar

    return calendarDays;
  }


</script>