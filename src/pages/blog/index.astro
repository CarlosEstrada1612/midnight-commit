---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/layout.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog — Midnight Commit">
  <div class="blog-layout">

    <!-- SIDEBAR IZQUIERDO -->
    <aside class="blog-sidebar-left">
      <!-- aquí van las ventanas del sidebar, las hacemos después -->
    </aside>

    <!-- CONTENIDO CENTRAL -->
    <main class="blog-main">

      <div class="blog-header">
        <span>blog / all entries</span>
        <span>{posts.length} posts</span>
      </div>

      {posts.map((post) => (
        <article class="post-entry">
          <div class="post-date">
            <span class="post-day">{post.data.pubDate.getDate()}</span>
            <span class="post-month">
              {post.data.pubDate.toLocaleDateString('en-US', { month: 'short' }).toUpperCase()}
            </span>
            <span class="post-year">{post.data.pubDate.getFullYear()}</span>
          </div>

          <div class="post-body">
            {post.data.category && <span class="post-category">{post.data.category.toUpperCase()}</span>}
            {post.data.minRead && <span class="post-readtime"> • {post.data.minRead} min read</span>}
            <h2 class="post-title">
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p class="post-description">{post.data.description}</p>
            <a href={`/blog/${post.id}/`} class="post-readmore">&gt; read entry_</a>
          </div>
        </article>
      ))}

    </main>

    <!-- SIDEBAR DERECHO -->
    <aside class="blog-sidebar-right">
      <!-- aquí van las ventanas del sidebar, las hacemos después -->
    </aside>

  </div>
</Layout>